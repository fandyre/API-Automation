{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "photoUrls"],
    "properties": {
      "id": { "type": "integer" },
      "name": { "type": "string" },
      "photoUrls": { "type": "array", "items": { "type": "string" } },
      "status": { "type": "string", "enum": ["available", "pending", "sold"] }
    }
  }
}
